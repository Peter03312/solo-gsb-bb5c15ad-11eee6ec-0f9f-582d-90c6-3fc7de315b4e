{
  "name": "backstage-cue-sheet",
  "version": "1.0.0",
  "private": true,
  "description": "小剧场演出提示单：版本化提示项、岗位口令确认、顺序互锁与实时同步",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
